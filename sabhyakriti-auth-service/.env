# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sabhyakriti_auth

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS
AWS_REGION=ap-south-1
SECRETS_MANAGER_JWT_PRIVATE_KEY=sabhyakriti/auth/jwt-private-key
SECRETS_MANAGER_AES_KEY=sabhyakriti/auth/aes-key
SECRETS_MANAGER_DB_PASSWORD=sabhyakriti/auth/db-password
SECRETS_MANAGER_GOOGLE_CLIENT_SECRET=sabhyakriti/auth/google-client-secret
SECRETS_MANAGER_FACEBOOK_CLIENT_SECRET=sabhyakriti/auth/facebook-client-secret
SECRETS_MANAGER_TWILIO_AUTH_TOKEN=sabhyakriti/auth/twilio-auth-token

# OAuth (non-secret values)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
FACEBOOK_CLIENT_ID=your-facebook-app-id

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+91xxxxxxxxxx

# App
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=DEBUG
ENVIRONMENT=development
