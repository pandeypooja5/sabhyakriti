# Database
DATABASE_URL=postgresql+asyncpg://sabhyakriti:password@localhost:5432/sabhyakriti

# Internal service communication
ORDER_SERVICE_URL=http://localhost:8001
NOTIFICATION_SERVICE_URL=http://localhost:8006
INTERNAL_SERVICE_SECRET=change-this-to-a-strong-secret-value

# JWT authentication (public key fetched from JWKS endpoint)
JWT_PUBLIC_KEY_URL=http://localhost:8000/.well-known/jwks.json

# AWS configuration
AWS_REGION=ap-south-1

# AWS Secrets Manager key names (values stored as plaintext strings)
SECRETS_MANAGER_RAZORPAY_KEY_ID=sabhyakriti/payment/razorpay_key_id
SECRETS_MANAGER_RAZORPAY_KEY_SECRET=sabhyakriti/payment/razorpay_key_secret
SECRETS_MANAGER_RAZORPAY_WEBHOOK_SECRET=sabhyakriti/payment/razorpay_webhook_secret

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=INFO

# Application
APP_ENV=development
APP_PORT=8005
