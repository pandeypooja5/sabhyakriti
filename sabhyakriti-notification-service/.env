# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sabhyakriti

# ─── AWS / SES ────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
SES_FROM_EMAIL=no-reply@sabhyakriti.com
SES_FROM_NAME=Sabhyakriti

# ─── Twilio SMS ───────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# ─── AWS SNS (SMS fallback) ───────────────────────────────────────────────────
SNS_SMS_REGION=ap-south-1

# ─── Internal Security ────────────────────────────────────────────────────────
INTERNAL_SERVICE_SECRET=change-me-to-a-long-random-secret

# ─── Application ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
PORT=8006
WORKERS=2
