# Database
DATABASE_URL=postgresql+asyncpg://cart_user:cart_pass@localhost:5432/sabhyakriti

# Internal service communication
PRODUCT_SERVICE_URL=http://localhost:8001
ORDER_SERVICE_URL=http://localhost:8002
INTERNAL_SERVICE_SECRET=change-me-in-production

# Authentication (RS256 JWT public key endpoint)
JWT_PUBLIC_KEY_URL=http://localhost:8000/.well-known/jwks.json

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# AWS
AWS_REGION=ap-south-1

# Logging
LOG_LEVEL=INFO

# AWS Secrets Manager (optional, for production)
# SECRET_NAME=sabhyakriti/cart-service/secrets
