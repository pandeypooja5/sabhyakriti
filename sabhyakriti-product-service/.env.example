# Database
DATABASE_PRIMARY_URL=postgresql+asyncpg://postgres:password@localhost:5432/sabhyakriti
DATABASE_REPLICA_URL=postgresql+asyncpg://postgres:password@localhost:5432/sabhyakriti

# Redis
REDIS_URL=redis://localhost:6379/1

# AWS
AWS_REGION=ap-south-1
S3_BUCKET_NAME=sabhyakriti-product-images
CLOUDFRONT_DOMAIN=d1234567890abc.cloudfront.net

# Internal service communication
ORDER_SERVICE_INTERNAL_URL=http://order-service:8001
INTERNAL_SERVICE_SECRET=change-me-super-secret

# Auth
JWT_PUBLIC_KEY_URL=http://auth-service:8000/internal/v1/auth/jwks.json

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=INFO

# App
APP_ENV=development
APP_PORT=8002
