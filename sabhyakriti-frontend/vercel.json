{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/auth/:path*",
      "destination": "https://auth-sabhyakriti.up.railway.app/api/v1/auth/:path*"
    },
    {
      "source": "/api/v1/users/:path*",
      "destination": "https://auth-sabhyakriti.up.railway.app/api/v1/users/:path*"
    },
    {
      "source": "/auth/.well-known/:path*",
      "destination": "https://auth-sabhyakriti.up.railway.app/auth/.well-known/:path*"
    },
    {
      "source": "/api/v1/products/:path*",
      "destination": "https://product-sabhyakriti.up.railway.app/api/v1/products/:path*"
    },
    {
      "source": "/api/v1/categories/:path*",
      "destination": "https://product-sabhyakriti.up.railway.app/api/v1/categories/:path*"
    },
    {
      "source": "/api/v1/reviews/:path*",
      "destination": "https://product-sabhyakriti.up.railway.app/api/v1/reviews/:path*"
    },
    {
      "source": "/api/v1/media/:path*",
      "destination": "https://product-sabhyakriti.up.railway.app/api/v1/media/:path*"
    },
    {
      "source": "/api/v1/cart/:path*",
      "destination": "https://cart-sabhyakriti.up.railway.app/api/v1/cart/:path*"
    },
    {
      "source": "/api/v1/wishlist/:path*",
      "destination": "https://cart-sabhyakriti.up.railway.app/api/v1/wishlist/:path*"
    },
    {
      "source": "/api/v1/orders/:path*",
      "destination": "https://order-sabhyakriti.up.railway.app/api/v1/orders/:path*"
    },
    {
      "source": "/api/v1/addresses/:path*",
      "destination": "https://order-sabhyakriti.up.railway.app/api/v1/addresses/:path*"
    },
    {
      "source": "/api/v1/payments/:path*",
      "destination": "https://payment-sabhyakriti.up.railway.app/api/v1/payments/:path*"
    },
    {
      "source": "/api/v1/admin/:path*",
      "destination": "https://admin-sabhyakriti.up.railway.app/api/v1/admin/:path*"
    }
  ]
}
