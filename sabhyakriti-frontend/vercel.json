{
  "buildCommand": "echo 'Build skipped - using pre-built dist'",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/api/v1/auth/(.*)", "dest": "https://auth-service-production-a5fc.up.railway.app/api/v1/auth/$1" },
    { "src": "/api/v1/users/(.*)", "dest": "https://auth-service-production-a5fc.up.railway.app/api/v1/users/$1" },
    { "src": "/auth/.well-known/(.*)", "dest": "https://auth-service-production-a5fc.up.railway.app/auth/.well-known/$1" },

    { "src": "/api/v1/products(/.*)?", "dest": "https://product-service-production-8cfc.up.railway.app/api/v1/products$1" },
    { "src": "/api/v1/categories(/.*)?", "dest": "https://product-service-production-8cfc.up.railway.app/api/v1/categories$1" },
    { "src": "/api/v1/reviews/(.*)", "dest": "https://product-service-production-8cfc.up.railway.app/api/v1/reviews/$1" },
    { "src": "/api/v1/media/(.*)", "dest": "https://product-service-production-8cfc.up.railway.app/api/v1/media/$1" },

    { "src": "/api/v1/cart(/.*)?", "dest": "https://cart-service-production-d74d.up.railway.app/api/v1/cart$1" },
    { "src": "/api/v1/wishlist(/.*)?", "dest": "https://cart-service-production-d74d.up.railway.app/api/v1/wishlist$1" },

    { "src": "/api/v1/orders(/.*)?", "dest": "https://order-service-production-8de4.up.railway.app/api/v1/orders$1" },
    { "src": "/api/v1/addresses(/.*)?", "dest": "https://order-service-production-8de4.up.railway.app/api/v1/addresses$1" },

    { "src": "/api/v1/payments(/.*)?", "dest": "https://payment-service-production-77ae.up.railway.app/api/v1/payments$1" },

    { "src": "/api/v1/admin(/.*)?", "dest": "https://admin-service-production-e7f1.up.railway.app/api/v1/admin$1" },

    { "handle": "filesystem" },

    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
